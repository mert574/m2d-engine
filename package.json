{
  "name": "m2d",
  "private": true,
  "version": "1.0.0",
  "description": "A lightweight 2D game engine (npm workspaces monorepo)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples",
    "docs"
  ],
  "scripts": {
    "dev": "npm run dev --workspace examples",
    "dev:lan": "npm run dev:lan --workspace examples",
    "build": "npm run build:docs && npm run build:examples && rm -rf site && cp -r docs/dist site && cp -r examples/dist/. site/examples/",
    "build:docs": "npm run build --workspace docs",
    "build:examples": "npm run build --workspace examples",
    "docs:dev": "npm run dev --workspace docs",
    "preview": "npm run preview --workspace examples",
    "generate-sprites": "npm run generate-sprites --workspace examples",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace packages/engine",
    "test:node": "npm run test:node --workspace packages/engine",
    "test:browser": "npm run test:browser --workspace packages/engine"
  },
  "author": "Mert Yildiz",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
