{
  "name": "m2d",
  "private": true,
  "version": "1.0.0",
  "description": "A lightweight 2D game engine (npm workspaces monorepo)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples",
    "docs"
  ],
  "scripts": {
    "dev": "npm run dev --workspace examples",
    "dev:lan": "npm run dev:lan --workspace examples",
    "build-assets": "npm run build-assets --workspace examples",
    "build-models": "npm run build-models --workspace examples",
    "build": "npm run build:docs && npm run build:examples && rm -rf site && cp -r docs/dist site && cp -r examples/dist/. site/examples/",
    "build:docs": "npm run build --workspace docs",
    "build:examples": "npm run build --workspace examples",
    "docs:dev": "npm run dev --workspace docs",
    "editor": "node packages/editor-host/src/serve.ts",
    "editor:mcp": "node packages/editor-host/src/mcp.ts",
    "preview": "npm run preview --workspace examples",
    "generate-sprites": "npm run generate-sprites --workspace examples",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "test": "npm run typecheck && npm run lint && npm run types:ratchet && npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace packages/engine",
    "test:node": "npm run test:node --workspace packages/engine",
    "test:gpu": "npm run test:gpu --workspace packages/engine",
    "test:browser": "npm run test:browser --workspace packages/engine",
    "test:editor": "node scripts/driveEditor.mjs",
    "types:ratchet": "node scripts/typesRatchet.ts",
    "lint": "oxlint --quiet ."
  },
  "author": "Mert Yildiz",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.21.5": true,
    "webgpu@0.6.2": true,
    "@onirenaud/node-webgl@0.2.0": true
  },
  "devDependencies": {
    "oxlint": "1.66.0",
    "typescript": "^7.0.2"
  }
}
