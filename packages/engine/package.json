{
  "name": "m2d-engine",
  "version": "1.11.0",
  "description": "A 2D browser game engine: Rapier physics, batched WebGL2 rendering, a deterministic fixed tick, JSON scenes and one input API",
  "type": "module",
  "exports": {
    ".": "./src/core/m2d.js",
    "./*": "./src/*",
    "./test/helpers/*": "./test/helpers/*"
  },
  "scripts": {
    "test": "vitest run --project node --project gpu",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:watch": "vitest --project node",
    "test:node": "vitest run --project node",
    "test:gpu": "vitest run --project gpu",
    "test:browser": "vitest run --project browser"
  },
  "author": "Mert Yildiz",
  "license": "MIT",
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "recast-navigation": "^0.44.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@onirenaud/node-webgl": "0.2.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "vitest": "^5.0.5",
    "webgpu": "0.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mert574/m2d-engine.git",
    "directory": "packages/engine"
  },
  "homepage": "https://mert574.github.io/m2d-engine/",
  "keywords": [
    "game-engine",
    "2d",
    "webgl2",
    "rapier",
    "physics",
    "browser",
    "deterministic"
  ]
}
