{
  "name": "m2d-engine",
  "version": "1.6.1",
  "description": "A 2D browser game engine: Rapier physics, batched WebGL2 rendering with a Canvas 2D fallback, a deterministic fixed tick, JSON scenes and one input API",
  "type": "module",
  "exports": {
    ".": "./src/core/m2d.js",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:browser",
    "test:watch": "vitest --project node",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser"
  },
  "author": "Mert Yildiz",
  "license": "MIT",
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@dimforge/rapier3d-compat": "^0.21.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mert574/m2d-engine.git",
    "directory": "packages/engine"
  },
  "homepage": "https://mert574.github.io/m2d-engine/",
  "keywords": [
    "game-engine",
    "2d",
    "webgl2",
    "canvas",
    "rapier",
    "physics",
    "browser",
    "deterministic"
  ]
}
