{
  "name": "m2d-editor-host",
  "private": true,
  "version": "0.1.0",
  "description": "The m2d editor's host: serves the editor app and the project's own code and assets through Vite, watches the project, will run the asset compilers, and speaks MCP over stdio for agents",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "bin": {
    "m2d-editor": "./src/serve.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "author": "Mert Yildiz",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "m2d-editor-core": "*",
    "m2d-engine": "*",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mert574/m2d-engine.git",
    "directory": "packages/editor-host"
  }
}
