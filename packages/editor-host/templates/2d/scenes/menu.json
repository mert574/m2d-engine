{
  "version": 4,
  "name": "menu",
  "type": "ui",
  "title": "Menu",
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.25 },
  "stagger": 0.08,
  "elements": [
    {
      "type": "backdrop",
      "id": "sky",
      "properties": {
        "from": "#fbe3c4",
        "to": "#9fc4e8",
        "angle": 100,
        "motes": 40,
        "moteColor": "#ffffff",
        "vignette": 0.35
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": 120,
      "y": -120,
      "anchor": "left",
      "effects": { "enter": { "motion": "slide-right", "duration": 0.4 } },
      "properties": {
        "text": "MY GAME",
        "fontSize": "$font.size.display",
        "fontWeight": "$font.weight.bold",
        "color": "#2b3a4a"
      }
    },
    {
      "type": "menuItem",
      "id": "start",
      "x": 120,
      "y": -20,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.3 },
        "select": "lift",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Start",
        "onClick": "level",
        "color": "#4a5a6a",
        "selectedColor": "#1d2a38",
        "accentColor": "#ff7a59"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": 120,
      "y": 30,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.3 },
        "select": "lift",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "color": "#4a5a6a",
        "selectedColor": "#1d2a38",
        "accentColor": "#ff7a59"
      }
    }
  ]
}
