# Dependencies
node_modules/

# Build output
dist/
/site/

# VitePress generated files (keep config and theme sources tracked)
**/.vitepress/cache/
**/.vitepress/.temp/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Image assets
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.ico

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local secrets and unreviewed example assets.
.env
.env.*
!.env.example
*.otf
*.mp3
*.wav

# Licensed demo textures (credits in THIRD_PARTY_NOTICES.md)
!/examples/src/*/textures/*.jpg
!/examples/src/*/textures/*.png
# Licensed demo sound loops (credits in THIRD_PARTY_NOTICES.md)
!/examples/src/*/sounds/*.wav
