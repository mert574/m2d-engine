# Dependencies
node_modules/

# Build output
dist/
/site/

# VitePress generated files (keep config and theme sources tracked)
**/.vitepress/cache/
**/.vitepress/.temp/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Image assets
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.ico

# Self-signed certificate for the HTTPS dev server (per machine; `npm run dev:lan`)
/examples/.certs/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local secrets and unreviewed example assets.
.env
.env.*
!.env.example
*.otf
*.mp3
*.wav

# Free demo textures (credits in THIRD_PARTY_NOTICES.md)
!/examples/src/*/textures/*.jpg
!/examples/src/*/textures/*.png
!/examples/src/*/textures/**/*.png
# In-game thumbnails for the example index pages
!/docs/examples/shots/*.jpg
!/examples/src/shots/*.jpg
# Free demo sound loops (credits in THIRD_PARTY_NOTICES.md)
!/examples/src/*/sounds/*.wav

# Free demo music in mp3 (credits in THIRD_PARTY_NOTICES.md)
!/examples/src/shared/music/*.mp3

# Local gameplay captures (drag into the GitHub README editor to publish)
/recordings/
