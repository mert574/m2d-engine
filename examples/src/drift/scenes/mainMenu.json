{
  "version": 4,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "assets": { "music": { "menu": { "url": "music/binarypulse-symmetrical-tree.ogg", "volume": 0.6 } } },
  "transition": { "enter": "slide-up", "exit": "fade", "duration": 0.3 },
  "stagger": 0.08,
  "music": { "track": "menu" },
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "from": "#06070f",
        "to": "#0b0c1c",
        "angle": 160,
        "scanlines": 0.18,
        "vignette": 0.5,
        "layers": ["fieldWindow"],
        "wash": { "side": "right", "strength": 0.85 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": -80,
      "y": -150,
      "anchor": "right",
      "effects": { "enter": { "motion": "slide-left", "duration": 0.4 } },
      "properties": {
        "text": "Salvage Run",
        "fontSize": "$font.size.title",
        "fontWeight": "$font.weight.light",
        "letterSpacing": "$font.tracking.tight",
        "color": "#cfe8ff",
        "align": "right"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": -80,
      "y": -102,
      "anchor": "right",
      "properties": {
        "text": "A ROTATING TOP-DOWN VIEW",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.widest",
        "color": "#9fe2ff",
        "align": "right"
      }
    },
    {
      "type": "menuItem",
      "id": "launch",
      "x": -80,
      "y": -20,
      "anchor": "right",
      "effects": {
        "enter": { "motion": "slide-left", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Launch",
        "onClick": "field",
        "variant": "block",
        "align": "right",
        "width": 300,
        "letterSpacing": "$font.tracking.wider",
        "color": "#7fa7c9",
        "selectedColor": "#06070f",
        "accentColor": "#9fe2ff"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": -80,
      "y": 30,
      "anchor": "right",
      "effects": {
        "enter": { "motion": "slide-left", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "block",
        "align": "right",
        "width": 300,
        "letterSpacing": "$font.tracking.wider",
        "color": "#7fa7c9",
        "selectedColor": "#06070f",
        "accentColor": "#9fe2ff"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": -80,
      "y": -56,
      "anchor": "bottom-right",
      "properties": {
        "text": "Arrows steer and thrust · X fires · C boosts · O for settings",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(159, 226, 255, 0.55)",
        "align": "right"
      }
    }
  ]
}
