{
  "version": 5,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "assets": { "music": { "menu": { "url": "music/binarypulse-symmetrical-tree.ogg", "volume": 0.6 } } },
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.3 },
  "stagger": 0.06,
  "music": { "track": "menu" },
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "from": "#06070f",
        "to": "#0b0c1c",
        "angle": 160,
        "vignette": 0.5,
        "layers": ["fieldWindow"],
        "wash": { "side": "right", "strength": 0.85 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": -96,
      "y": -140,
      "anchor": "right",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Salvage Run",
        "fontSize": "$font.size.title",
        "fontWeight": "$font.weight.light",
        "letterSpacing": "$font.tracking.tight",
        "color": "#e6f3ff",
        "align": "right"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": -96,
      "y": -86,
      "anchor": "right",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "A ROTATING TOP-DOWN VIEW",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.widest",
        "color": "#8fb3d1",
        "align": "right"
      }
    },
    {
      "type": "menuItem",
      "id": "launch",
      "x": -83,
      "y": -24,
      "anchor": "right",
      "effects": {
        "enter": { "motion": "slide-left", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Launch",
        "onClick": "field",
        "variant": "block",
        "align": "right",
        "width": 300,
        "letterSpacing": "$font.tracking.wider",
        "color": "#8fb3d1",
        "selectedColor": "#06070f",
        "accentColor": "#bfe6ff"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": -83,
      "y": 26,
      "anchor": "right",
      "effects": {
        "enter": { "motion": "slide-left", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "block",
        "align": "right",
        "width": 300,
        "letterSpacing": "$font.tracking.wider",
        "color": "#8fb3d1",
        "selectedColor": "#06070f",
        "accentColor": "#bfe6ff"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": -96,
      "y": -56,
      "anchor": "bottom-right",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Arrows steer and thrust · X fires · C boosts · O for settings",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(191, 230, 255, 0.5)",
        "align": "right"
      }
    }
  ]
}
