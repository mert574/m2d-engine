{
  "version": 6,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "assets": { "music": { "menu": { "url": "music/nathanrain-stars-at-dawn.ogg", "volume": 0.7 } } },
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.3 },
  "stagger": 0.06,
  "music": { "track": "menu" },
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "from": "#f4b45c",
        "to": "#f9dda0",
        "angle": 170,
        "vignette": 0.42,
        "layers": ["meadowRest"],
        "wash": { "side": "left", "strength": 0.6 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": 120,
      "y": -120,
      "anchor": "left",
      "effects": { "enter": { "motion": "slide-right", "duration": 0.35 } },
      "properties": {
        "text": "Beeline",
        "fontSize": "$font.size.display",
        "fontWeight": "$font.weight.light",
        "letterSpacing": "$font.tracking.tight",
        "color": "#ffffff"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 120,
      "y": -46,
      "anchor": "left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "AN AUTO-SCROLLER INTO THE DUSK",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.semibold",
        "letterSpacing": "$font.tracking.widest",
        "color": "#fff3c4"
      }
    },
    {
      "type": "menuItem",
      "id": "fly",
      "x": 107,
      "y": 30,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Fly the lane",
        "onClick": "lane",
        "variant": "dot",
        "width": 300,
        "fontSize": "$font.size.subheading",
        "letterSpacing": "$font.tracking.wider",
        "color": "#f5efe2",
        "selectedColor": "#ffffff",
        "accentColor": "#ffd23f"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": 107,
      "y": 80,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "dot",
        "width": 300,
        "fontSize": "$font.size.subheading",
        "letterSpacing": "$font.tracking.wider",
        "color": "#f5efe2",
        "selectedColor": "#ffffff",
        "accentColor": "#ffd23f"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": 120,
      "y": -56,
      "anchor": "bottom-left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Arrows fly · Space dashes · chain pollen, read the wasps, tear the webs",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(255, 255, 255, 0.75)"
      }
    }
  ]
}
