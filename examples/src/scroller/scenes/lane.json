    "rules": [
      {
        "id": "brief",
        "when": { "event": "start" },
        "then": [
          { "do": "notice", "text": "Reach the hive before dark", "seconds": 3.6 },
          {
            "do": "notice",
            "text": "chain the pollen — the combo keeps the score climbing",
            "seconds": 3.6,
            "element": "sub"
          }
        ]
      },
      {
        "id": "home",
        "when": { "event": "notify", "name": "arrived" },
        "then": [{ "do": "sound", "key": "arrived" }, { "do": "switch", "scene": "mainMenu", "after": 5 }]
      },
      {
        "id": "menu",
        "when": { "event": "action", "action": "menu" },
        "then": [{ "do": "switch", "scene": "mainMenu" }]
      }
    ]
