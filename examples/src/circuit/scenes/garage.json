{
  "version": 4,
  "name": "garage",
  "type": "ui",
  "title": "Garage",
  "assets": {
    "images": {
      "carRed": { "url": "textures/car_red_1.png" },
      "carBlue": { "url": "textures/car_blue_1.png" },
      "carGreen": { "url": "textures/car_green_1.png" }
    }
  },
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.3 },
  "stagger": 0.04,
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "from": "#0b0d1c",
        "to": "#232743",
        "angle": 160,
        "vignette": 0.5,
        "layers": ["nightLap"],
        "wash": { "side": "left", "strength": 0.94 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": 96,
      "y": -200,
      "anchor": "left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Garage",
        "fontSize": "$font.size.title",
        "fontWeight": "$font.weight.thin",
        "letterSpacing": "$font.tracking.tight",
        "color": "#ffffff"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 96,
      "y": -146,
      "anchor": "left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "SPEED AGAINST HANDLING",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.widest",
        "color": "#ffd34d"
      }
    },
    {
      "type": "menuItem",
      "id": "car-sprint",
      "x": 83,
      "y": -92,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Sprint",
        "onClick": "mainMenu",
        "set": { "choice": "car", "value": "sprint" },
        "variant": "block",
        "width": 320,
        "letterSpacing": "$font.tracking.wider",
        "color": "#c7cbe0",
        "selectedColor": "#0b0d1c",
        "accentColor": "#ffd34d"
      }
    },
    {
      "type": "menuItem",
      "id": "car-balanced",
      "x": 83,
      "y": -44,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Tourer",
        "onClick": "mainMenu",
        "set": { "choice": "car", "value": "balanced" },
        "variant": "block",
        "width": 320,
        "letterSpacing": "$font.tracking.wider",
        "color": "#c7cbe0",
        "selectedColor": "#0b0d1c",
        "accentColor": "#ffd34d"
      }
    },
    {
      "type": "menuItem",
      "id": "car-drift",
      "x": 83,
      "y": 4,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Slider",
        "onClick": "mainMenu",
        "set": { "choice": "car", "value": "drift" },
        "variant": "block",
        "width": 320,
        "letterSpacing": "$font.tracking.wider",
        "color": "#c7cbe0",
        "selectedColor": "#0b0d1c",
        "accentColor": "#ffd34d"
      }
    },
    {
      "type": "menuItem",
      "id": "back",
      "x": 83,
      "y": 76,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Back",
        "onClick": "mainMenu",
        "variant": "block",
        "width": 320,
        "letterSpacing": "$font.tracking.wider",
        "color": "#c7cbe0",
        "selectedColor": "#0b0d1c",
        "accentColor": "#ffd34d"
      }
    },
    {
      "type": "component",
      "id": "onShow",
      "x": 260,
      "y": -10,
      "anchor": "center",
      "component": "carOnShow",
      "properties": { "accent": "#ffd34d" }
    },
    {
      "type": "text",
      "id": "hint",
      "x": 96,
      "y": -48,
      "anchor": "bottom-left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Enter picks · Back keeps the car you have",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(199, 203, 224, 0.5)"
      }
    }
  ]
}
