{
  "version": 5,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "assets": { "music": { "menu": { "url": "music/kloquewurk-last-transmission.ogg" } } },
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.3 },
  "stagger": 0.06,
  "music": { "track": "menu" },
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "from": "#080412",
        "to": "#1a0e2c",
        "angle": 115,
        "scanlines": 0.1,
        "vignette": 0.62,
        "layers": ["motionTracker"],
        "wash": { "side": "left", "strength": 0.7 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": 96,
      "y": -100,
      "anchor": "left",
      "effects": { "enter": { "motion": "type", "duration": 0.4 } },
      "properties": {
        "text": "TOP-DOWN",
        "fontSize": "$font.size.display",
        "fontFamily": "$font.mono",
        "color": "#f1ecff"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 96,
      "y": -30,
      "anchor": "left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "A DEMONSTRATION",
        "fontSize": "$font.size.label",
        "fontFamily": "$font.mono",
        "letterSpacing": "$font.tracking.widest",
        "color": "#b49cff"
      }
    },
    {
      "type": "menuItem",
      "id": "start",
      "x": 83,
      "y": 40,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "fade", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Start Game",
        "onClick": "level1",
        "variant": "bracket",
        "fontSize": "$font.size.heading",
        "fontFamily": "$font.mono",
        "letterSpacing": "$font.tracking.wide",
        "color": "#8f86a8",
        "selectedColor": "#f1ecff",
        "accentColor": "#b49cff"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": 83,
      "y": 96,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "fade", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "bracket",
        "fontSize": "$font.size.heading",
        "fontFamily": "$font.mono",
        "letterSpacing": "$font.tracking.wide",
        "color": "#8f86a8",
        "selectedColor": "#f1ecff",
        "accentColor": "#b49cff"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": 96,
      "y": -56,
      "anchor": "bottom-left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Arrows move · X attacks · O for settings",
        "fontSize": "$font.size.label",
        "fontFamily": "$font.mono",
        "color": "rgba(241, 236, 255, 0.45)"
      }
    }
  ]
}
