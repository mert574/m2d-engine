{
  "version": 7,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.3 },
  "stagger": 0.06,
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "from": "#6f8dbd",
        "to": "#d4dfef",
        "angle": 180,
        "vignette": 0.35,
        "layers": ["yardAfternoon"],
        "wash": { "side": "left", "strength": 0.6 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": 96,
      "y": -110,
      "anchor": "left",
      "effects": { "enter": { "motion": "slide-right", "duration": 0.35 } },
      "properties": {
        "text": "The Yard",
        "fontSize": "$font.size.display",
        "fontWeight": "$font.weight.thin",
        "letterSpacing": "$font.tracking.tight",
        "color": "#fff8ec"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 96,
      "y": -34,
      "anchor": "left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "THREE DIMENSIONS, ON WEBGPU",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.semibold",
        "letterSpacing": "$font.tracking.widest",
        "color": "#e6dccb"
      }
    },
    {
      "type": "menuItem",
      "id": "yard",
      "x": 83,
      "y": 40,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "The Yard",
        "onClick": "yard",
        "variant": "bar",
        "width": 300,
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.wider",
        "color": "#e6dccb",
        "selectedColor": "#fff8ec",
        "accentColor": "#fff1da"
      }
    },
    {
      "type": "menuItem",
      "id": "lot",
      "x": 83,
      "y": 90,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "The Lot",
        "onClick": "lot",
        "variant": "bar",
        "width": 300,
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.wider",
        "color": "#e6dccb",
        "selectedColor": "#fff8ec",
        "accentColor": "#fff1da"
      }
    },
    {
      "type": "menuItem",
      "id": "court",
      "x": 83,
      "y": 140,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "The Court",
        "onClick": "court",
        "variant": "bar",
        "width": 300,
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.wider",
        "color": "#e6dccb",
        "selectedColor": "#fff8ec",
        "accentColor": "#fff1da"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": 83,
      "y": 190,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "bar",
        "width": 300,
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.wider",
        "color": "#e6dccb",
        "selectedColor": "#fff8ec",
        "accentColor": "#fff1da"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": 96,
      "y": -64,
      "anchor": "bottom-left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Drag orbits · Scroll zooms · WASD walks the fox · T dusk · Esc back here · Chromium only",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(255, 248, 236, 0.55)"
      }
    }
  ]
}
