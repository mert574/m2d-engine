{
  "version": 5,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.3 },
  "stagger": 0.06,
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "from": "#110904",
        "to": "#2c1a0d",
        "angle": 120,
        "vignette": 0.55,
        "layers": ["galtonBoard"],
        "wash": { "side": "left", "strength": 0.85 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": 96,
      "y": -110,
      "anchor": "left",
      "effects": { "enter": { "motion": "slide-right", "duration": 0.35 } },
      "properties": {
        "text": "Physics",
        "fontSize": "$font.size.display",
        "fontWeight": "$font.weight.black",
        "letterSpacing": "$font.tracking.tight",
        "color": "#f4f0ea"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 96,
      "y": -34,
      "anchor": "left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "A PLAYGROUND",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.semibold",
        "letterSpacing": "$font.tracking.widest",
        "color": "#d8d2c8"
      }
    },
    {
      "type": "menuItem",
      "id": "start",
      "x": 83,
      "y": 40,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Start Game",
        "onClick": "workshop",
        "variant": "block",
        "width": 300,
        "fontWeight": "$font.weight.bold",
        "letterSpacing": "$font.tracking.wider",
        "color": "#d8d2c8",
        "selectedColor": "#120c06",
        "accentColor": "#ece6dc"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": 83,
      "y": 90,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "block",
        "width": 300,
        "fontWeight": "$font.weight.bold",
        "letterSpacing": "$font.tracking.wider",
        "color": "#d8d2c8",
        "selectedColor": "#120c06",
        "accentColor": "#ece6dc"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": 96,
      "y": -64,
      "anchor": "bottom-left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Drag to grab · Right-click removes · Click or Space drops · ↑ ↓ gravity · O for settings",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(244, 240, 234, 0.45)"
      }
    }
  ]
}
