{
  "version": 4,
  "name": "workshop",
  "type": "level",
  "title": "The workshop",
  "gameType": "sideScroll",
  "world": {
    "width": 960,
    "height": 720,
    "gravity": { "x": 0, "y": 1000 },
    "camera": { "bounds": "world" },
    "lighting": { "ambient": "#e6e2da" },
    "post": {
      "bloom": { "threshold": 0.78, "strength": 0.45, "blur": 26 },
      "vignette": { "strength": 0.24, "start": 0.55 },
      "grade": { "shadows": "#948a80", "highlights": "#fff8ea", "amount": 0.42, "contrast": 1.03 },
      "chromatic": { "strength": 0.002 },
      "distortion": { "strength": 0.05 },
      "grain": { "strength": 0.04 }
    },
    "counters": { "gravity": { "initial": 1000, "min": 0, "max": 3000 } },
    "gravityBind": [{ "counter": "gravity", "axis": "y" }],
    "rules": [
      {
        "id": "heavier",
        "when": { "event": "action", "action": "heavier" },
        "then": [{ "do": "count", "counter": "gravity", "add": 200 }],
        "once": false
      },
      {
        "id": "lighter",
        "when": { "event": "action", "action": "lighter" },
        "then": [{ "do": "count", "counter": "gravity", "add": -200 }],
        "once": false
      },
      {
        "id": "menu",
        "when": { "event": "action", "action": "menu" },
        "then": [{ "do": "switch", "scene": "mainMenu" }]
      },
      {
        "id": "earth",
        "when": { "event": "action", "action": "earthGravity" },
        "then": [{ "do": "count", "counter": "gravity", "set": 1000 }],
        "once": false
      }
    ]
  },
  "assets": {
    "sounds": { "spawn": { "url": "sounds/drop_003.ogg" }, "remove": { "url": "sounds/minimize_006.ogg" } }
  },
  "prefabs": {
    "ball": {
      "actor": "Ball",
      "physics": {
        "bodyType": "dynamic",
        "shape": "circle",
        "friction": 0.005,
        "frictionAir": 0.001,
        "restitution": 0.8
      },
      "constraints": { "grab": { "type": "Grabbable", "params": { "removable": true, "removeSound": "remove" } } }
    },
    "box": {
      "actor": "Box",
      "physics": { "bodyType": "dynamic", "restitution": 0.4 },
      "constraints": { "grab": { "type": "Grabbable", "params": { "removable": true, "removeSound": "remove" } } }
    },
    "housing": { "actor": "Housing", "physics": { "bodyType": "static" } },
    "girder": { "actor": "Girder", "physics": { "bodyType": "static" } },
    "peg": { "actor": "Peg", "physics": { "bodyType": "static" } },
    "workshop": { "actor": "WorkshopBackdrop", "physics": { "bodyType": "static", "isSensor": true } },
    "spout": { "actor": "Spout", "physics": { "bodyType": "static", "isSensor": true } }
  },
  "layers": [
    {
      "name": "room",
      "objects": [
        {
