{
  "version": 4,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "assets": { "music": { "menu": { "url": "music/kloquewurk-last-transmission.ogg", "volume": 0.7 } } },
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.3 },
  "stagger": 0.06,
  "music": { "track": "menu" },
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "from": "#1a1210",
        "to": "#07060a",
        "angle": 160,
        "vignette": 0.6,
        "layers": ["vaultPlan"],
        "wash": { "side": "left", "strength": 0.82 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": 112,
      "y": -296,
      "anchor": "bottom-left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Cinder Keep",
        "fontSize": "$font.size.title",
        "fontWeight": "$font.weight.semibold",
        "letterSpacing": "$font.tracking.tight",
        "color": "#f4f0ea"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 112,
      "y": -244,
      "anchor": "bottom-left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "AN ISOMETRIC VIEW",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.widest",
        "color": "#d9452f"
      }
    },
    {
      "type": "menuItem",
      "id": "descend",
      "x": 99,
      "y": -196,
      "anchor": "bottom-left",
      "effects": {
        "enter": { "motion": "fade", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Descend",
        "onClick": "keep",
        "variant": "dot",
        "fontSize": "$font.size.subheading",
        "letterSpacing": "$font.tracking.wide",
        "color": "#a9a39b",
        "selectedColor": "#f4f0ea",
        "accentColor": "#d9452f"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": 99,
      "y": -148,
      "anchor": "bottom-left",
      "effects": {
        "enter": { "motion": "fade", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "dot",
        "fontSize": "$font.size.subheading",
        "letterSpacing": "$font.tracking.wide",
        "color": "#a9a39b",
        "selectedColor": "#f4f0ea",
        "accentColor": "#d9452f"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": 112,
      "y": -64,
      "anchor": "bottom-left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Click to walk · Arrows move · X swings · 1 2 3 abilities · Wheel zooms · O for settings",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(244, 240, 234, 0.45)"
      }
    }
  ]
}
