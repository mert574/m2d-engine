{
  "version": 6,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "assets": { "music": { "menu": { "url": "music/matthewpablo-enchanted-festival.mp3", "volume": 0.5 } } },
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.3 },
  "stagger": 0.06,
  "music": { "track": "menu" },
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": { "from": "#2a1a2e", "to": "#0a1410", "angle": 170, "vignette": 0.55, "layers": ["treeLine"] }
    },
    {
      "type": "text",
      "id": "title",
      "x": 0,
      "y": -116,
      "anchor": "center",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Hollow Grove",
        "fontSize": "$font.size.display",
        "fontWeight": "$font.weight.thin",
        "letterSpacing": "$font.tracking.tight",
        "color": "#f2f6fa",
        "align": "center"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 0,
      "y": -40,
      "anchor": "center",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "A THREE-QUARTER VIEW · A SMALL QUEST",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.widest",
        "color": "#9fd3b4",
        "align": "center"
      }
    },
    {
      "type": "menuItem",
      "id": "enter",
      "x": 0,
      "y": 34,
      "anchor": "center",
      "effects": {
        "enter": { "motion": "fade", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Enter the grove",
        "onClick": "grove",
        "variant": "underline",
        "align": "center",
        "width": 360,
        "fontSize": "$font.size.subheading",
        "letterSpacing": "$font.tracking.wider",
        "color": "#b7c2cc",
        "selectedColor": "#f2f6fa",
        "accentColor": "#9fd3b4"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": 0,
      "y": 84,
      "anchor": "center",
      "effects": {
        "enter": { "motion": "fade", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "underline",
        "align": "center",
        "width": 360,
        "fontSize": "$font.size.subheading",
        "letterSpacing": "$font.tracking.wider",
        "color": "#b7c2cc",
        "selectedColor": "#f2f6fa",
        "accentColor": "#9fd3b4"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": 0,
      "y": -56,
      "anchor": "bottom",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Arrows move · Space hops · X swings · 1 2 3 abilities · E talks · Wheel zooms",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(242, 246, 250, 0.5)",
        "align": "center"
      }
    }
  ]
}
