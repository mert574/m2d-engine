{
  "version": 6,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "assets": { "music": { "menu": { "url": "music/nathanrain-stars-at-dawn.ogg" } } },
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.3 },
  "stagger": 0.06,
  "music": { "track": "menu" },
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "motes": 28,
        "moteColor": "#ffe9b8",
        "vignette": 0.5,
        "layers": ["duskValley"],
        "wash": { "side": "bottom", "strength": 0.75 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": 0,
      "y": 150,
      "anchor": "top",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Platformer",
        "fontSize": "$font.size.display",
        "fontWeight": "$font.weight.thin",
        "letterSpacing": "$font.tracking.tight",
        "color": "#ffffff",
        "align": "center"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 0,
      "y": 226,
      "anchor": "top",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "A DEMONSTRATION",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.widest",
        "color": "rgba(255, 255, 255, 0.7)",
        "align": "center"
      }
    },
    {
      "type": "menuItem",
      "id": "start",
      "x": -140,
      "y": -150,
      "anchor": "bottom",
      "effects": {
        "enter": { "motion": "fade", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Start Game",
        "onClick": "level1",
        "variant": "underline",
        "align": "center",
        "width": 260,
        "letterSpacing": "$font.tracking.wider",
        "color": "#e9e4dc",
        "selectedColor": "#ffffff",
        "accentColor": "#ffffff"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": 140,
      "y": -150,
      "anchor": "bottom",
      "effects": {
        "enter": { "motion": "fade", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "underline",
        "align": "center",
        "width": 260,
        "letterSpacing": "$font.tracking.wider",
        "color": "#e9e4dc",
        "selectedColor": "#ffffff",
        "accentColor": "#ffffff"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": 0,
      "y": -72,
      "anchor": "bottom",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Arrows move · Space jumps · X attacks · O for settings",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(255, 255, 255, 0.55)",
        "align": "center"
      }
    }
  ]
}
