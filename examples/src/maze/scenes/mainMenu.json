{
  "version": 4,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "assets": { "music": { "menu": { "url": "music/binarypulse-symmetrical-tree.ogg" } } },
  "transition": { "enter": "fade", "exit": "fade", "duration": 0.3 },
  "stagger": 0.06,
  "music": { "track": "menu" },
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "from": "#16200f",
        "to": "#2a3b1c",
        "angle": 120,
        "motes": 14,
        "vignette": 0.55,
        "layers": ["gardenPlan"],
        "wash": { "side": "left", "strength": 0.85 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": 64,
      "y": -96,
      "anchor": "left",
      "effects": { "enter": { "motion": "slide-right", "duration": 0.35 } },
      "properties": {
        "text": "Hedgerow Court",
        "fontSize": "$font.size.title",
        "fontWeight": "$font.weight.semibold",
        "letterSpacing": "$font.tracking.tight",
        "color": "#ffffff"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 64,
      "y": -46,
      "anchor": "left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "A GARDEN IN THREE COURTS",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.medium",
        "letterSpacing": "$font.tracking.widest",
        "color": "#d6e86a"
      }
    },
    {
      "type": "menuItem",
      "id": "start",
      "x": 51,
      "y": 22,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Start Game",
        "onClick": "court1",
        "variant": "bar",
        "width": 280,
        "letterSpacing": "$font.tracking.wider",
        "color": "#c3cbb2",
        "selectedColor": "#ffffff",
        "accentColor": "#d6e86a"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": 51,
      "y": 66,
      "anchor": "left",
      "effects": {
        "enter": { "motion": "slide-right", "duration": 0.35 },
        "select": "none",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "bar",
        "width": 280,
        "letterSpacing": "$font.tracking.wider",
        "color": "#c3cbb2",
        "selectedColor": "#ffffff",
        "accentColor": "#d6e86a"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": 64,
      "y": -60,
      "anchor": "bottom-left",
      "effects": { "enter": { "motion": "fade", "duration": 0.4 } },
      "properties": {
        "text": "Press an arrow to set off, the same one to stop · tend the beds · O for settings",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(255, 255, 255, 0.5)"
      }
    }
  ]
}
