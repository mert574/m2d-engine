{
  "version": 4,
  "name": "court2",
  "type": "level",
  "title": "The Long Borders",
  "gameType": "topDown",
  "world": {
    "width": 2016,
    "height": 960,
    "gravity": { "x": 0, "y": 0 },
    "player": "player-1",
    "camera": {
      "mode": "rooms",
      "lerp": 0.12,
      "roomSize": { "width": 672, "height": 480 },
      "bounds": "world"
    },
    "lighting": { "ambient": "#fffdf2" },
    "post": {
      "bloom": { "threshold": 0.82, "strength": 0.32, "blur": 18 },
      "vignette": { "strength": 0.13, "start": 0.64 },
      "grade": {
        "shadows": "#8aa381",
        "highlights": "#fff8e2",
        "amount": 0.32,
        "saturation": 1.08,
        "contrast": 1.02
      },
      "grain": { "strength": 0.03 }
    },
    "music": { "track": "game" },
    "counters": { "beds": { "initial": 0, "max": 55 }, "bedsTotal": { "prefab": "bed", "count": "placed" } },
    "rules": [
      {
        "id": "title",
        "when": { "event": "start" },
        "then": [{ "do": "notice", "text": "The Long Borders", "seconds": 3 }]
      },
      {
        "id": "tend",
        "when": { "event": "emit", "name": "tended" },
        "then": [{ "do": "count", "counter": "beds", "add": 1 }, { "do": "sound", "key": "bloom" }],
        "once": false
      },
      {
        "id": "all-tended",
        "when": { "event": "count", "counter": "beds", "atLeast": 55 },
        "then": [{ "do": "notice", "text": "Every bed in bloom", "seconds": 2.2 }]
      },
      {
        "id": "walked",
        "when": { "event": "notify", "name": "fountain" },
        "then": [
          { "do": "sound", "key": "solved" },
          {
            "do": "notice",
            "text": "The borders are walked. The old yew court waits...",
            "seconds": 2.5
          },
          { "do": "switch", "scene": "court3", "after": 1.8 }
        ]
      },
      {
        "id": "menu",
        "when": { "event": "action", "action": "menu" },
        "then": [{ "do": "switch", "scene": "mainMenu" }]
      }
    ]
  },
  "assets": {
    "spritesheets": {
      "hedge": { "url": "textures/hedge.jpg", "frameWidth": 512, "frameHeight": 512 },
      "fountain": { "url": "textures/fountain.png", "frameWidth": 256, "frameHeight": 256 }
    },
    "images": { "lawn": { "url": "textures/lawn.jpg" }, "plaza": { "url": "textures/plaza.png" } },
    "sounds": {
      "solved": { "url": "sounds/maximize_006.ogg" },
      "bloom": { "url": "sounds/confirmation_001.ogg", "volume": 0.5 }
    },
    "music": { "game": { "url": "music/halogen-redux.ogg" } }
  },
  "prefabs": {
    "player": {
      "actor": "Gardener",
      "physics": { "bodyType": "character", "shape": "circle", "frictionAir": 0.2 },
      "constraints": { "movement": { "type": "GlideControl", "params": { "speed": 230, "grid": 32 } } }
    },
    "hedge": { "actor": "Platform", "spritesheet": "hedge", "physics": { "bodyType": "static" } },
