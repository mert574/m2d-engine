{
  "version": 4,
  "name": "court1",
  "type": "level",
  "title": "The East Lawn",
  "gameType": "topDown",
  "world": {
    "width": 1344,
    "height": 960,
    "gravity": { "x": 0, "y": 0 },
    "player": "player-1",
    "camera": {
      "mode": "rooms",
      "lerp": 0.12,
      "roomSize": { "width": 672, "height": 480 },
      "bounds": "world"
    },
    "lighting": { "ambient": "#fffdf2" },
    "post": {
      "bloom": { "threshold": 0.82, "strength": 0.32, "blur": 18 },
      "vignette": { "strength": 0.13, "start": 0.64 },
      "grade": {
        "shadows": "#8aa381",
        "highlights": "#fff8e2",
        "amount": 0.32,
        "saturation": 1.08,
        "contrast": 1.02
      },
      "grain": { "strength": 0.03 }
    },
    "music": { "track": "game" },
    "counters": { "beds": { "initial": 0, "max": 32 }, "bedsTotal": { "prefab": "bed", "count": "placed" } },
    "rules": [
      {
        "id": "title",
        "when": { "event": "start" },
        "then": [{ "do": "notice", "text": "The East Lawn", "seconds": 3 }]
      },
      {
        "id": "tend",
        "when": { "event": "emit", "name": "tended" },
        "then": [{ "do": "count", "counter": "beds", "add": 1 }, { "do": "sound", "key": "bloom" }],
        "once": false
      },
      {
        "id": "all-tended",
        "when": { "event": "count", "counter": "beds", "atLeast": 32 },
        "then": [{ "do": "notice", "text": "Every bed in bloom", "seconds": 2.2 }]
      },
      {
        "id": "walked",
        "when": { "event": "notify", "name": "fountain" },
        "then": [
          { "do": "sound", "key": "solved" },
          {
            "do": "notice",
            "text": "The east lawn is yours. On to the long borders...",
            "seconds": 2.5
          },
          { "do": "switch", "scene": "court2", "after": 1.8 }
        ]
      },
      {
        "id": "menu",
        "when": { "event": "action", "action": "menu" },
        "then": [{ "do": "switch", "scene": "mainMenu" }]
      }
    ]
  },
  "assets": {
    "spritesheets": {
      "hedge": { "url": "textures/hedge.jpg", "frameWidth": 512, "frameHeight": 512 },
      "fountain": { "url": "textures/fountain.png", "frameWidth": 256, "frameHeight": 256 }
    },
    "images": { "lawn": { "url": "textures/lawn.jpg" }, "plaza": { "url": "textures/plaza.png" } },
    "sounds": {
      "solved": { "url": "sounds/maximize_006.ogg" },
      "bloom": { "url": "sounds/confirmation_001.ogg", "volume": 0.5 }
    },
    "music": { "game": { "url": "music/halogen-redux.ogg" } }
  },
