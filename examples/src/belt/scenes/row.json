{
  "version": 4,
  "name": "row",
  "type": "level",
  "gameType": "belt",
  "uses": { "zombie": "prefab-zombie", "goblin": "prefab-goblin", "skeleton": "prefab-skeleton" },
  "world": {
    "width": 5200,
    "height": 400,
    "gravity": { "x": 0, "y": 0 },
    "sort": "depth",
    "projection": { "type": "belt", "ratio": 0.5 },
    "camera": { "lerp": 0.12, "bounds": { "left": 0, "top": -2000, "right": 5200, "bottom": 264 } },
    "lighting": { "ambient": "#f2ecdf" },
    "post": {
      "bloom": { "threshold": 0.85, "strength": 0.2, "blur": 18 },
      "vignette": { "strength": 0.18, "start": 0.72 },
      "grade": {
        "shadows": "#3a3a52",
        "highlights": "#fff2d8",
        "amount": 0.22,
        "saturation": 1.12,
        "contrast": 1.04
      }
    },
    "music": { "track": "game" },
    "clearColor": "#5fa6e4",
    "rules": [
      {
        "when": { "event": "start" },
        "then": [
          { "do": "objective", "text": "SECTION 1 / 5 · 2 THUGS" },
          { "do": "camera", "right": 1540 }
        ]
      },
      {
        "id": "clear-1",
        "when": { "event": "death", "objects": ["s1-zombie-1", "s1-zombie-2"] },
        "then": [
          { "do": "sound", "key": "go" },
          { "do": "notice", "text": "GO  →", "seconds": 2, "element": "go" },
          { "do": "camera", "right": 2540 },
          { "do": "objective", "text": "GO →" }
        ]
      },
      {
        "id": "arm-2",
        "when": { "event": "enter", "object": "zone-2" },
        "then": [
          { "do": "unseal", "object": "s2-goblin-1" },
          { "do": "unseal", "object": "s2-goblin-2" },
          { "do": "unseal", "object": "s2-goblin-3" },
          { "do": "objective", "text": "SECTION 2 / 5 · 3 THUGS" }
        ],
        "after": ["clear-1"]
      },
      {
        "id": "clear-2",
        "when": { "event": "death", "objects": ["s2-goblin-1", "s2-goblin-2", "s2-goblin-3"] },
        "then": [
          { "do": "sound", "key": "go" },
          { "do": "notice", "text": "GO  →", "seconds": 2, "element": "go" },
          { "do": "camera", "right": 3540 },
          { "do": "objective", "text": "GO →" }
        ],
        "after": ["arm-2"]
      },
      {
        "id": "arm-3",
        "when": { "event": "enter", "object": "zone-3" },
        "then": [
          { "do": "unseal", "object": "s3-zombie-1" },
          { "do": "unseal", "object": "s3-zombie-2" },
          { "do": "unseal", "object": "s3-skeleton-1" },
          { "do": "unseal", "object": "s3-skeleton-2" },
          { "do": "objective", "text": "SECTION 3 / 5 · 4 THUGS" }
        ],
        "after": ["clear-2"]
      },
      {
        "id": "clear-3",
        "when": {
          "event": "death",
          "objects": ["s3-zombie-1", "s3-zombie-2", "s3-skeleton-1", "s3-skeleton-2"]
        },
        "then": [
          { "do": "sound", "key": "go" },
          { "do": "notice", "text": "GO  →", "seconds": 2, "element": "go" },
          { "do": "camera", "right": 4540 },
          { "do": "objective", "text": "GO →" }
        ],
        "after": ["arm-3"]
      },
      {
        "id": "arm-4",
        "when": { "event": "enter", "object": "zone-4" },
        "then": [
          { "do": "unseal", "object": "s4-goblin-1" },
          { "do": "unseal", "object": "s4-goblin-2" },
          { "do": "unseal", "object": "s4-skeleton-1" },
          { "do": "unseal", "object": "s4-skeleton-2" },
          { "do": "unseal", "object": "s4-zombie-1" },
          { "do": "unseal", "object": "s4-zombie-2" },
          { "do": "objective", "text": "SECTION 4 / 5 · 6 THUGS" }
        ],
        "after": ["clear-3"]
      },
      {
        "id": "clear-4",
        "when": {
          "event": "death",
          "objects": [
            "s4-goblin-1",
            "s4-goblin-2",
            "s4-skeleton-1",
            "s4-skeleton-2",
            "s4-zombie-1",
            "s4-zombie-2"
          ]
        },
        "then": [
          { "do": "sound", "key": "go" },
          { "do": "notice", "text": "GO  →", "seconds": 2, "element": "go" },
          { "do": "camera", "right": 5440 },
          { "do": "objective", "text": "GO →" }
        ],
        "after": ["arm-4"]
      },
      {
        "id": "arm-5",
        "when": { "event": "enter", "object": "zone-5" },
        "then": [
          { "do": "unseal", "object": "s5-skeleton-1" },
          { "do": "unseal", "object": "s5-skeleton-2" },
          { "do": "unseal", "object": "s5-skeleton-3" },
          { "do": "unseal", "object": "s5-skeleton-4" },
          { "do": "unseal", "object": "s5-zombie-1" },
          { "do": "unseal", "object": "s5-zombie-2" },
          { "do": "objective", "text": "SECTION 5 / 5 · 6 THUGS" }
        ],
        "after": ["clear-4"]
      },
      {
        "id": "clear-5",
        "when": {
          "event": "death",
          "objects": [
            "s5-skeleton-1",
            "s5-skeleton-2",
            "s5-skeleton-3",
            "s5-skeleton-4",
            "s5-zombie-1",
            "s5-zombie-2"
          ]
        },
        "then": [
          { "do": "sound", "key": "go" },
          { "do": "notice", "text": "GO  →", "seconds": 2, "element": "go" },
          { "do": "camera", "right": 5200 },
          { "do": "objective", "text": "THE DOOR IS OPEN" }
        ],
        "after": ["arm-5"]
      },
      {
        "when": { "event": "enter", "object": "door-1" },
        "then": [{ "do": "notice", "text": "NOT YET · CLEAR THE ROW", "seconds": 2, "element": "notice" }],
        "once": false,
        "before": ["clear-5"]
      },
      {
        "when": { "event": "enter", "object": "door-1" },
        "then": [
          { "do": "notice", "text": "YOU MADE IT OUT", "seconds": 60, "element": "notice" },
          { "do": "sound", "key": "levelComplete" },
          { "do": "switch", "scene": "mainMenu", "after": 3 }
        ],
        "after": ["clear-5"]
      },
      {
        "when": { "event": "action", "action": "menu" },
        "then": [{ "do": "switch", "scene": "mainMenu" }]
      }
    ]
  },
