{
  "version": 4,
  "name": "mainMenu",
  "type": "ui",
  "title": "Main Menu",
  "assets": { "music": { "menu": { "url": "music/kloquewurk-last-transmission.ogg", "volume": 0.7 } } },
  "transition": { "enter": "scale", "exit": "fade", "duration": 0.35 },
  "stagger": 0.08,
  "music": { "track": "menu" },
  "elements": [
    {
      "type": "backdrop",
      "id": "scene",
      "properties": {
        "from": "#79b7e8",
        "to": "#cfe6f4",
        "angle": 180,
        "vignette": 0.3,
        "layers": ["streetFront"],
        "wash": { "side": "bottom", "strength": 0.85 }
      }
    },
    {
      "type": "text",
      "id": "title",
      "x": 0,
      "y": 64,
      "anchor": "top",
      "effects": { "enter": { "motion": "drop", "duration": 0.6 } },
      "properties": {
        "text": "ASH ROW",
        "fontSize": "$font.size.display",
        "fontWeight": "$font.weight.black",
        "letterSpacing": "$font.tracking.wider",
        "color": "#fff4d6",
        "align": "center"
      }
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 0,
      "y": 150,
      "anchor": "top",
      "properties": {
        "text": "A BELT SCROLLER",
        "fontSize": "$font.size.caption",
        "fontWeight": "$font.weight.semibold",
        "letterSpacing": "$font.tracking.widest",
        "color": "#ffcf6b",
        "align": "center"
      }
    },
    {
      "type": "menuItem",
      "id": "start",
      "x": 0,
      "y": -200,
      "anchor": "bottom",
      "effects": {
        "enter": { "motion": "fade", "duration": 0.3 },
        "select": "pulse",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Walk the row",
        "onClick": "row",
        "variant": "bracket",
        "align": "center",
        "width": 420,
        "fontSize": "$font.size.heading",
        "fontWeight": "$font.weight.bold",
        "letterSpacing": "$font.tracking.wider",
        "color": "#f3e6c8",
        "selectedColor": "#ffffff",
        "accentColor": "#ff5a3c"
      }
    },
    {
      "type": "menuItem",
      "id": "settings",
      "x": 0,
      "y": -146,
      "anchor": "bottom",
      "effects": {
        "enter": { "motion": "fade", "duration": 0.3 },
        "select": "pulse",
        "exit": { "motion": "fade", "duration": 0.2 }
      },
      "properties": {
        "text": "Settings",
        "action": "settings",
        "variant": "bracket",
        "align": "center",
        "width": 420,
        "fontSize": "$font.size.heading",
        "fontWeight": "$font.weight.bold",
        "letterSpacing": "$font.tracking.wider",
        "color": "#f3e6c8",
        "selectedColor": "#ffffff",
        "accentColor": "#ff5a3c"
      }
    },
    {
      "type": "text",
      "id": "hint",
      "x": 0,
      "y": -64,
      "anchor": "bottom",
      "properties": {
        "text": "Arrows move · Space jumps · X chains punches · C sweeps · air X drop-kicks",
        "fontSize": "$font.size.caption",
        "letterSpacing": "$font.tracking.wide",
        "color": "rgba(255, 244, 214, 0.7)",
        "align": "center"
      }
    }
  ]
}
